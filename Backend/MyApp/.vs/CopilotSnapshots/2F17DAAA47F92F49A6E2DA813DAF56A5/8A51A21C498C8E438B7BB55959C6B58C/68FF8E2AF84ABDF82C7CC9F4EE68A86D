using System;

namespace MyApp
{
    // Basic enum
    public enum LogLevel
    {
        Trace,
        Debug,
        Info,
        Warning,
        Error,
        Fatal
    }

    // Enum with explicit values and underlying type
    public enum Status : byte
    {
        Inactive = 0,
        Active = 1,
        Suspended = 2,
        Deleted = 255
    }

    // Flags enum for bitwise combinations
    [Flags]
    public enum FilePermission
    {
        None = 0,
        Read = 1 << 0,    // 1
        Write = 1 << 1,   // 2
        Execute = 1 << 2, // 4
        ReadWrite = Read | Write
    }

    public static class EnumExamples
    {
        public static void Run()
        {
            // Assign and use
            LogLevel level = LogLevel.Warning;
            Console.WriteLine(level); // "Warning"

            // Switch on enum
            switch (level)
            {
                case LogLevel.Trace:
                case LogLevel.Debug:
                    Console.WriteLine("Verbose");
                    break;
                case LogLevel.Info:
                    Console.WriteLine("Information");
                    break;
                case LogLevel.Warning:
                    Console.WriteLine("Warning");
                    break;
                case LogLevel.Error:
                case LogLevel.Fatal:
                    Console.WriteLine("Error");
                    break;
            }

            // Parse and TryParse
            if (Enum.TryParse<LogLevel>("Error", ignoreCase: true, out var parsed))
                Console.WriteLine($"Parsed: {parsed}");

            // Iterate values
            foreach (LogLevel l in Enum.GetValues(typeof(LogLevel)))
                Console.WriteLine((int)l + " => " + l);

            // Flags usage
            FilePermission perms = FilePermission.Read | FilePermission.Write;
            bool canWrite = (perms & FilePermission.Write) != 0;
            Console.WriteLine($"CanWrite: {canWrite}");

            // Cast underlying value
            byte statusValue = (byte)Status.Active;
            Console.WriteLine($"Status value: {statusValue}");
        }
    }

    // Entry point for the application
    public static class Program
    {
        public static void Main(string[] args)
        {
            // Run the enum examples
            EnumExamples.Run();
        }
    }
}
