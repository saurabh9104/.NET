        /// <summary>
        /// View detailed information about a specific customer
        /// </summary>
        private static void ViewCustomerDetails()
        {
            Console.Clear();
            Console.WriteLine("\n===== CUSTOMER DETAILS =====");
            Console.Write("Enter Customer ID: ");

            if (!int.TryParse(Console.ReadLine(), out int customerId))
            {
                Console.WriteLine("❌ Invalid Customer ID");
                Console.ReadKey();
                return;
            }

            try
            {
                Customer customer = _customerRepo.GetById(customerId);

                if (customer == null)
                {
                    Console.WriteLine($"❌ Customer with ID {customerId} not found");
                    Console.ReadKey();
                    return;
                }

                Console.WriteLine("\n╔════════════════════════════════════╗");
                Console.WriteLine("║       CUSTOMER INFORMATION         ║");
                Console.WriteLine("╚════════════════════════════════════╝");
                Console.WriteLine($"\nCustomer ID: {customer.CustomerId}");
                Console.WriteLine($"Name: {customer.CustomerName}");
                Console.WriteLine($"Email: {customer.Email}");
                Console.WriteLine($"Phone: {customer.Phone}");
                Console.WriteLine($"Address ID: {customer.AddressId}");

                // Show customer orders
                List<Order> orders = _orderRepo.GetByCustomer(customerId);
                Console.WriteLine($"\n────── Orders Placed: {orders.Count} ──────");

                if (orders.Count > 0)
                {
                    Console.WriteLine("\n┌──────┬────────────────┬───────────────┐");
                    Console.WriteLine("│  ID  │   Order Date   │  Total Amount │");
                    Console.WriteLine("├──────┼────────────────┼───────────────┤");

                    foreach (var order in orders)
                    {
                        Console.WriteLine($"│ {order.OrderId:D4} │ {order.OrderDate:yyyy-MM-dd}   │ ${order.TotalAmount:F2,11} │");
                    }

                    Console.WriteLine("└──────┴────────────────┴───────────────┘");
                }
                else
                {
                    Console.WriteLine("\nNo orders found for this customer.");
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"\n❌ Error: {ex.Message}");
            }

            Console.WriteLine("\nPress any key to continue...");
            Console.ReadKey();
        }
    }
}
